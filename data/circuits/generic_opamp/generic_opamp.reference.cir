C2 Net-_Q1-C_ /outb 1u
R3 Net-_Q1-B_ 0 10k
Q1 Net-_Q1-C_ Net-_Q1-B_ Net-_Q1-E_ __Q1
R6 Net-_Q1-E_ 0 330
R7 /outb 0 100k
R4 +5V Net-_Q1-B_ 50k
.end
