.title KiCad schematic
.include "Simulation_SPICE.sp"
.model __Q1 NPN
V2 +5V 0 DC 5 
C1 /in Net-_Q1-B_ 1u
R2 Net-_U1--_ /in 10k
XU1 0 Net-_U1--_ +5V -5V /out kicad_builtin_opamp POLE=30 GAIN=100k VOFF=10u ROUT=10
R1 /out Net-_U1--_ 100k
V1 0 -5V DC 5 
V3 /in 0 DC 0 SIN( 0 0.1 1k 0 0 0 ) AC 1  
