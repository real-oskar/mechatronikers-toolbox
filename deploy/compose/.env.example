# Copy to deploy/compose/.env (git-ignored) and set a password of your own.
POSTGRES_PASSWORD=change-me
# Host port on 127.0.0.1 (default 5432).
MT_PG_PORT=5432
# Hub (profile hub): one browser credential and one token per worker host (name=token,…);
# create each with: uv run python -m mechatronikers.hub token
MT_HUB_SHARED_TOKEN=
MT_HUB_WORKER_TOKENS=
# Host port on 127.0.0.1 (default 8780); public origin if the hub sits behind a proxy.
MT_HUB_PORT=8780
MT_HUB_ORIGIN=http://127.0.0.1:8780
