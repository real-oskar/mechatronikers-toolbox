# One image for both sandbox roles (docs/07):
#   session: python -m mechatronikers.sandbox   (MCP servers, review app; default command)
#   runner:  python -m mechatronikers.runner    (one isolated build)

# Review UI (D55): built to static files here; the runtime image stays Python-only.
FROM docker.io/library/node:22.23.2-alpine AS ui
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM docker.io/library/python:3.13-slim-bookworm

# OpenCascade (OCP wheels) needs these shared libraries even when nothing is rendered.
# ngspice: operating-point check of exported netlists (circuit add-on, docs/12).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libxrender1 libxext6 libsm6 \
       ngspice \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --no-install-project
COPY src ./src
RUN uv sync --locked --no-dev --no-editable
COPY --from=ui /ui/dist /opt/review-ui
ENV MT_REVIEW_UI=/opt/review-ui

RUN useradd --uid 10001 --create-home app \
    && mkdir -p /session/input /session/builds /session/artifacts \
    && chown -R app:app /session
USER 10001
WORKDIR /session
# Set only after installing: Podman copies /tmp's image contents into the tmpfs mounted there.
# Libraries such as ezdxf want a writable cache; home is read-only at runtime.
ENV XDG_CACHE_HOME=/tmp/.cache

EXPOSE 8000
CMD ["python", "-m", "mechatronikers.sandbox"]
