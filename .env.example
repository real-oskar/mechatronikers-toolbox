# Copy to .env (git-ignored) and fill in. Never commit real keys.
OPENROUTER_API_KEY=
# Model id with image input at the provider, e.g. anthropic/claude-sonnet-5.5 on OpenRouter
MT_MODEL=anthropic/claude-sonnet-5.5
# init_chat_model provider (default openai: OpenRouter's OpenAI-compatible API, cost reported).
# Another provider (anthropic, google_genai, ollama, ...) reads its own key variable, e.g.
# ANTHROPIC_API_KEY, and needs its LangChain package, which is not a project dependency:
# uv run --with langchain-anthropic python -m mechatronikers.agent ...
# Its cost is estimated with MT_PRICE_INPUT / MT_PRICE_OUTPUT below.
# MT_MODEL_PROVIDER=openai
# Endpoint (default: OpenRouter for openai, else the provider's own), e.g. a local server
# MT_BASE_URL=http://127.0.0.1:11434
# Credit limits (OpenRouter credits = USD): per run and across all runs (var/agent-spend.json)
MT_BUDGET_RUN=1.0
MT_BUDGET_TOTAL=5.0
# Fallback prices per million tokens if the provider reports no cost (every provider but OpenRouter)
MT_PRICE_INPUT=2.0
MT_PRICE_OUTPUT=10.0
MT_MAX_FIX_ITERATIONS=3
# A hung call ends as an error instead of blocking a run (#145): seconds per model request
# (real calls took up to 779 s), the client's retries after a timeout, and seconds per MCP tool
# call into the sandbox. A timed-out attempt is charged its input plus MT_MODEL_MAX_OUTPUT_TOKENS
# (else 65536) output tokens; when set, that cap is also sent to the model as max_tokens.
MT_MODEL_TIMEOUT_S=900
MT_MODEL_MAX_RETRIES=2
MT_TOOL_TIMEOUT_S=600
# MT_MODEL_MAX_OUTPUT_TOKENS=
# Language of the reasons the model writes for reviewers (de or en); `--lang` overrides it
MT_LANG=en
# Sandbox image for agent, session CLI and test bench; `--image` overrides it
# MT_IMAGE=localhost/mechatronikers:dev
